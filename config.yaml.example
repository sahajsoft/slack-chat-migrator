# Updated config.yaml.example as per Sahaj Customization
# -------------------------------------------------------
# Slack → GChat Migration Configuration (slack-chat-migrator / Tool B)
# Deployed as /app/config.yaml inside the Cloud Run container.
# Override individual channels at the top level of this file.

# Shared Drive for file attachments.
# Tool B uploads Slack files here and links them in migrated messages.
shared_drive:
  name: "Imported Slack Attachments"

# Channels to exclude from migration (exact Slack channel names, without '#').
# Add DM-style directory names ("Dxxxxxxx", "mpdm-xxx") here if the export
# includes DMs and you want to skip them.
exclude_channels: []

# Channels to include — when specified, ONLY these channels are migrated.
# Leave empty to migrate everything in the export (minus exclude_channels).
# Example: include only two channels for a pilot run:
#   include_channels:
#     - general
#     - engineering
include_channels: []

# Normalise all Slack profile emails to @sahaj.ai.
# This ensures users who registered in Slack with a personal address still
# resolve to their Google Workspace account.
email_domain_override: "sahaj.ai"

# Manual overrides: map Slack user IDs that have no profile email to a
# known Google Workspace address. Run `make validate` first — the dry-run
# report lists all unmapped users with their Slack IDs.
#
# user_mapping_overrides:
#   "UXXXXXXXXX": "contractor@sahaj.ai"
#   "UYYYYYYYYY": "bot-account@sahaj.ai"
user_mapping_overrides: {}

# Skip bot messages and reactions (Slackbot, workflow bots, integrations).
ignore_bots: true

# Error handling
abort_on_error: false
max_failure_percentage: 10
import_completion_strategy: "skip_on_error"  # or "force_complete"
cleanup_on_error: false

# Retry settings
max_retries: 5
retry_delay: 2

# Space naming: set to "" to use the bare Slack channel name (no "Slack #" prefix).
space_name_prefix: ""

# Make migrated spaces publicly discoverable (DISCOVERABLE) after completing import.
# Set to false to leave spaces PRIVATE (invite-only).
make_spaces_discoverable: true
